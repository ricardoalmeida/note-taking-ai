# Test Environment Configuration
# These ports are used for E2E tests to avoid conflicts with development servers

# Server (Backend API) - runs on port 4000 during tests
TEST_SERVER_PORT=4000
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# Web (Frontend) - runs on port 4001 during tests
TEST_WEB_PORT=4001

# CORS - Allow test frontend to access backend
CORS_ORIGIN=http://localhost:4001

# Database
DATABASE_URL=file:./test.db

# Environment
NODE_ENV=test
